{
  "name": "ciurma",
  "version": "0.1.0",
  "description": "Run a crew of Claude Code agents as a research lab: roles, a shared blackboard, adversarial rituals, machines anywhere.",
  "type": "module",
  "license": "MIT",
  "author": "Eugenio Nerelli",
  "repository": { "type": "git", "url": "https://github.com/nerln/ciurma.git" },
  "bin": { "ciurma": "./dist/cli.js" },
  "files": ["dist", "src/roles", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx src/cli.ts hub",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.6.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
